// Enterprise AI Collaboration Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum SystemRole {
  SUPER_ADMIN
  USER
  ACCOUNTANT
}

enum OrgRole {
  OWNER
  ADMIN
  DIRECTOR
  PRINCIPAL
  DEAN
  HOD
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  ALUMNI
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
  TEAM
  DEPARTMENT
  PROJECT
  ANNOUNCEMENT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VIDEO
  AUDIO
  CODE
  SYSTEM
  AI
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssigneeStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXTENSION_REQUESTED
  SUBMITTED
  COMPLETED
}

enum NotificationType {
  MENTION
  TASK_ASSIGNED
  TASK_UPDATED
  DEADLINE_APPROACHING
  MEETING_INVITE
  AI_SUMMARY_READY
  APPROVAL_REQUEST
  ANNOUNCEMENT
  MESSAGE
  SYSTEM
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============ USER & AUTH ============

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String?
  fullName      String
  avatarUrl     String?
  systemRole    SystemRole @default(USER)
  isVerified    Boolean    @default(false)
  phoneNumber   String?    @unique
  isActive      Boolean    @default(true)
  googleId      String?    @unique
  lastSeenAt    DateTime?
  status        String?    @default("offline")
  bio           String?
  timezone      String?    @default("UTC")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  memberships       Membership[]
  refreshTokens     RefreshToken[]
  emailVerifications EmailVerificationToken[]
  ownedOrgs         Organization[]     @relation("OrgOwner")
  sentMessages      Message[]          @relation("MessageSender")
  channelMembers    ChannelMember[]
  reactions         Reaction[]
  messageReads      MessageRead[]
  pinnedMessages    PinnedMessage[]
  createdTasks      Task[]             @relation("TaskCreator")
  assignedTasks     TaskAssignee[]
  taskComments      TaskComment[]
  notifications     Notification[]
  meetingAttendees  MeetingAttendee[]
  createdMeetings   Meeting[]          @relation("MeetingCreator")
  aiConversations   AIConversation[]
  auditLogs         AuditLog[]
  uploadedFiles     FileAsset[]

  @@index([email])
  @@index([googleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ============ ORGANIZATION HIERARCHY ============

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  logoUrl     String?
  ownerId     String
  owner       User         @relation("OrgOwner", fields: [ownerId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  memberships Membership[]
  departments Department[]
  channels    Channel[]
  tasks       Task[]
  meetings    Meeting[]
  files       FileAsset[]
  notifications Notification[]
  auditLogs   AuditLog[]
  rolePermissions RolePermission[]

  @@index([slug])
}

model Department {
  id        String       @id @default(uuid())
  name      String
  orgId     String
  headId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teams        Team[]
  memberships  Membership[]

  @@index([orgId])
  @@index([orgId, deletedAt])
}

model Team {
  id           String       @id @default(uuid())
  name         String
  departmentId String
  managerId    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  projects     Project[]
  projectTeams ProjectTeam[]

  @@index([departmentId])
  @@index([departmentId, deletedAt])
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  teamId      String?
  status      String       @default("active")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  team        Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teams       ProjectTeam[]
  memberships Membership[]
  tasks       Task[]
  channels    Channel[]

  @@index([teamId])
}

model ProjectTeam {
  projectId String
  teamId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
}

model Membership {
  id           String   @id @default(uuid())
  userId       String
  orgId        String
  departmentId String?
  teamId       String?
  projectId    String?
  role         OrgRole  @default(TEACHER)
  title        String?
  joinedAt     DateTime @default(now())
  isActive     Boolean  @default(true)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@index([role])
  @@index([orgId, isActive])
  @@index([departmentId])
  @@index([teamId])
}

// ============ CHAT ============

model Channel {
  id          String       @id @default(uuid())
  orgId       String
  name        String
  description String?
  type        ChannelType  @default(PUBLIC)
  isArchived  Boolean      @default(false)
  createdById String?
  projectId   String?
  topic       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  members      ChannelMember[]
  messages     Message[]
  pinnedMessages PinnedMessage[]

  @@index([orgId])
  @@index([type])
  @@index([orgId, deletedAt])
}

model ChannelMember {
  id         String   @id @default(uuid())
  channelId  String
  userId     String
  isAdmin    Boolean  @default(false)
  joinedAt   DateTime @default(now())
  lastReadAt DateTime?
  notifications Boolean @default(true)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

model Message {
  id          String      @id @default(uuid())
  channelId   String
  senderId    String?
  content     String
  type        MessageType @default(TEXT)
  parentId    String?
  isEdited    Boolean     @default(false)
  isDeleted   Boolean     @default(false)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  channel     Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User?       @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  parent      Message?    @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Message[]   @relation("MessageReplies")
  attachments Attachment[]
  reactions   Reaction[]
  reads       MessageRead[]
  pinnedInfo  PinnedMessage?

  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([parentId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model PinnedMessage {
  id         String   @id @default(uuid())
  messageId  String   @unique
  channelId  String
  pinnedById String
  pinnedAt   DateTime @default(now())

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinnedBy  User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
}

// ============ FILES / ATTACHMENTS ============

model FileAsset {
  id           String   @id @default(uuid())
  uploaderId   String
  orgId        String?
  originalName String
  storedPath   String
  mimeType     String
  size         Int
  metadata     Json?
  createdAt    DateTime @default(now())

  uploader     User          @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@index([uploaderId])
}

model Attachment {
  id        String  @id @default(uuid())
  messageId String?
  taskId    String?
  meetingId String?
  fileId    String

  message Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  task    Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  meeting Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  file    FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

// ============ TASKS ============

model Task {
  id             String       @id @default(uuid())
  orgId          String
  projectId      String?
  parentId       String?
  createdById    String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float?
  recurrenceRule String?
  aiGenerated    Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent       Task?           @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks     Task[]          @relation("TaskSubtasks")
  createdBy    User            @relation("TaskCreator", fields: [createdById], references: [id])
  assignees    TaskAssignee[]
  comments     TaskComment[]
  checklist    TaskChecklist[]
  dependencies TaskDependency[] @relation("TaskDeps")
  dependents   TaskDependency[] @relation("TaskDependents")
  attachments  Attachment[]

  @@index([orgId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

model TaskAssignee {
  id               String             @id @default(uuid())
  taskId           String
  userId           String
  status           TaskAssigneeStatus @default(PENDING)
  assignedAt       DateTime           @default(now())
  respondedAt      DateTime?
  note             String?
  requestedDueDate DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskChecklist {
  id       String  @id @default(uuid())
  taskId   String
  content  String
  isDone   Boolean @default(false)
  position Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id             String @id @default(uuid())
  taskId         String
  dependsOnId    String

  task      Task @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

// ============ MEETINGS ============

model Meeting {
  id           String        @id @default(uuid())
  orgId        String
  createdById  String
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  location     String?
  meetingUrl   String?
  status       MeetingStatus @default(SCHEDULED)
  agenda       String?
  notes        String?
  aiSummary    String?
  aiActionItems Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("MeetingCreator", fields: [createdById], references: [id])
  attendees    MeetingAttendee[]
  attachments  Attachment[]

  @@index([orgId])
  @@index([startTime])
}

model MeetingAttendee {
  id         String   @id @default(uuid())
  meetingId  String
  userId     String
  status     String   @default("invited")
  attended   Boolean  @default(false)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String           @id @default(uuid())
  userId    String
  orgId     String?
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============ AI ============

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  sessionKey String  @unique
  title     String?
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ============ AUDIT ============

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  orgId     String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============ ROLE PERMISSIONS & CUSTOM ROLES ============

model RolePermission {
  id          String   @id @default(uuid())
  orgId       String
  role        String
  description String?
  isSystem    Boolean  @default(false)
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, role])
  @@index([orgId])
}

// ============ ATTENDANCE, HOMEWORK SUBMISSIONS & PARENT LINKS ============

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  orgId        String
  teamId       String
  studentId    String
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  recordedById String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([teamId, studentId, date])
  @@index([orgId])
  @@index([teamId, date])
  @@index([studentId])
}

model HomeworkSubmission {
  id            String   @id @default(uuid())
  taskId        String
  studentId     String
  content       String?
  attachmentUrl String?
  gradeScore    Float?
  gradeMax      Float?   @default(100)
  rubricScores  Json?
  feedbackNotes String?
  submittedAt   DateTime @default(now())
  gradedAt      DateTime?

  @@unique([taskId, studentId])
  @@index([taskId])
  @@index([studentId])
}

model ParentStudentLink {
  id            String   @id @default(uuid())
  orgId         String
  parentUserId  String
  studentUserId String
  relationship  String?  @default("Parent")
  createdAt     DateTime @default(now())

  @@unique([orgId, parentUserId, studentUserId])
  @@index([orgId])
  @@index([parentUserId])
  @@index([studentUserId])
}

// ============ FINANCIAL MODELS (TALLY & BUSY SYNC) ============

model StudentFeeLedger {
  id              String    @id @default(uuid())
  orgId           String
  studentId       String?
  studentRollNo   String?
  studentName     String
  feeHeader       String
  academicYear    String    @default("2026-2027")
  totalAmount     Float
  paidAmount      Float     @default(0)
  pendingBalance  Float
  dueDate         DateTime?
  status          String    @default("PENDING") // PAID, PENDING, OVERDUE, PARTIAL
  receiptNo       String?
  tallyVoucherId  String?
  paymentMethod   String?   @default("BANK_TRANSFER")
  notes           String?
  tallySyncStatus String    @default("SYNCED_MASTER") // SYNCED_MASTER, STAGED_FOR_TALLY
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
  @@index([studentId])
  @@index([studentRollNo])
  @@index([status])
}

model PayrollRecord {
  id             String    @id @default(uuid())
  orgId          String
  userId         String?
  employeeId     String?
  employeeName   String
  designation    String?
  month          String
  year           Int       @default(2026)
  basicPay       Float
  allowances     Float     @default(0)
  deductions     Float     @default(0)
  netSalary      Float
  status         String    @default("DISBURSED") // DISBURSED, PENDING, PROCESSING
  tallyVoucherId String?
  payslipUrl     String?
  disbursedAt    DateTime? @default(now())
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId])
  @@index([userId])
  @@index([employeeId])
  @@index([month, year])
}

// ============ TIMETABLE & SUBSTITUTE TEACHER MANAGEMENT ============

model TimetableSlot {
  id                 String   @id @default(uuid())
  orgId              String
  departmentId       String?
  teamId             String?  // Class/Section ID
  className          String   // e.g. "Class 10-A", "Computer Science 3rd Year"
  dayOfWeek          String   // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  periodNumber       Int      // 1 to 8
  startTime          String   // e.g. "09:00 AM"
  endTime            String   // e.g. "09:45 AM"
  subjectName        String   // e.g. "Physics", "Data Structures"
  roomNumber         String?  // e.g. "Room 302", "Lab 4"
  primaryTeacherId   String?
  primaryTeacherName String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([orgId])
  @@index([departmentId])
  @@index([teamId])
  @@index([primaryTeacherId])
  @@index([dayOfWeek, periodNumber])
}

model TeacherAbsence {
  id            String   @id @default(uuid())
  orgId         String
  teacherUserId String
  teacherName   String
  departmentId  String?
  date          DateTime
  reason        String?
  status        String   @default("ABSENT") // ABSENT, ON_LEAVE
  createdAt     DateTime @default(now())

  @@index([orgId])
  @@index([teacherUserId])
  @@index([date])
}

model ProxyAssignment {
  id                   String   @id @default(uuid())
  orgId                String
  slotId               String
  date                 DateTime
  originalTeacherId    String?
  originalTeacherName  String
  substituteTeacherId  String
  substituteTeacherName String
  assignedByUserId     String
  assignedByRole       String   // HOD, DEAN, PRINCIPAL
  status               String   @default("ASSIGNED") // ASSIGNED, COMPLETED, CANCELLED
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([orgId])
  @@index([slotId])
  @@index([date])
  @@index([substituteTeacherId])
}

model AcademicPromotionConfig {
  id             String   @id @default(uuid())
  orgId          String
  orderIndex     Int
  fromClassName  String
  toClassName    String
  isEntryLevel   Boolean  @default(false)
  isUnifiedPool  Boolean  @default(false)
  isAlumniTarget Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, orderIndex])
}

model AcademicBatchArchive {
  id            String   @id @default(uuid())
  orgId         String
  sessionName   String
  archivedAt    DateTime @default(now())
  structureJson String   @db.Text
  studentCount  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([orgId])
  @@index([orgId, archivedAt])
}

model AlumniGroup {
  id        String   @id @default(uuid())
  orgId     String
  batchYear Int
  channelId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, batchYear])
  @@index([orgId])
}

model ExpenseRecord {
  id              String   @id @default(uuid())
  orgId           String
  title           String
  category        String   @default("MAINTENANCE")
  amount          Float    @default(0)
  expenseDate     DateTime @default(now())
  paymentMethod   String?  @default("BANK_TRANSFER")
  bankAccountName String?  @default("HDFC Bank Main Account")
  vendorName      String?
  receiptNo       String?
  tallyVoucherId  String?
  status          String   @default("PAID")
  academicYear    String   @default("2026-27")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, category])
}

model BankAccount {
  id             String   @id @default(uuid())
  orgId          String
  accountName    String
  bankName       String
  accountNumber  String
  ifscCode       String?
  branchName     String?
  accountType    String   @default("CURRENT")
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  isPrimary      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, isActive])
}

model SocietyFund {
  id               String   @id @default(uuid())
  orgId            String
  fundName         String   // e.g., "General Trust Corpus", "Campus Infrastructure Fund", "Scholarship Endowment"
  fundType         String   @default("CORPUS") // CORPUS, INFRASTRUCTURE, SCHOLARSHIP, TRUST_GRANT, DEVELOPMENT
  contributingBody String   // e.g., "Education Trust Society", "Govt Higher Ed Grant", "Philanthropic Trustee"
  amount           Float    @default(0)
  fundDate         DateTime @default(now())
  isRestricted     Boolean  @default(false)
  purpose          String?  // Purpose or donor restriction details
  bankAccountId    String?  // Optional linked bank account holding this fund
  receiptNo        String?
  notes            String?
  status           String   @default("ACTIVE") // ACTIVE, UTILIZED, CLOSED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, fundType])
}

model CashRegister {
  id             String   @id @default(uuid())
  orgId          String
  registerName   String   // e.g., "Main Admissions Counter Cash", "Admin Petty Cash Float", "Principal Office Cash"
  custodianName  String?  // Person in charge e.g., "Senior Cashier", "Head Accountant"
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, isActive])
}

model CashTransaction {
  id               String   @id @default(uuid())
  orgId            String
  registerId       String
  transactionType  String   // CASH_IN, CASH_OUT, BANK_WITHDRAWAL, BANK_DEPOSIT, EXPENSE_PAYMENT, FEE_COLLECTION
  amount           Float
  transactionDate  DateTime @default(now())
  recipientOrPayer String?
  category         String?  // FEE_PAYMENT, PETTY_EXPENSE, BANK_FLOAT_TRANSFER
  voucherNumber    String?
  notes            String?
  createdAt        DateTime @default(now())

  @@index([orgId])
  @@index([registerId])
  @@index([orgId, transactionDate])
}

model FixedAsset {
  id                      String   @id @default(uuid())
  orgId                   String
  assetName               String   // e.g., "Physics Lab Spectrometer", "School Bus - Tata Starbus 40-Seater", "Dell Lab PCs (Batch 1)"
  category                String   // LAND_BUILDING, IT_HARDWARE, LAB_EQUIPMENT, VEHICLES, FURNITURE, LIBRARY_BOOKS, SMART_CLASSROOM
  assetCode               String?  // Asset Tag / Serial No e.g., "AST-2026-0042"
  purchaseDate            DateTime @default(now())
  purchasePrice           Float    @default(0)
  vendorName              String?
  invoiceNo               String?
  location                String?  // e.g., "Science Block - Lab 2", "Transport Depot", "Main Building Floor 1"
  depreciationRate        Float    @default(0) // Annual percentage e.g., 15.0 (%)
  depreciationMethod      String   @default("STRAIGHT_LINE") // STRAIGHT_LINE, WDV (Written Down Value)
  accumulatedDepreciation Float    @default(0)
  currentBookValue        Float    @default(0) // purchasePrice - accumulatedDepreciation
  status                  String   @default("ACTIVE") // ACTIVE, UNDER_MAINTENANCE, DISPOSED, WRITTEN_OFF
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, category])
  @@index([orgId, status])
}

model TallyTombstone {
  id              String   @id @default(uuid())
  orgId           String
  entityType      String   // FEE, EXPENSE, PAYROLL, SOCIETY_FUND, FIXED_ASSET, CASH_TRANSACTION, BANK_ACCOUNT
  entityId        String
  voucherNumber   String?
  remoteId        String?
  tallySyncStatus String   @default("PENDING_TALLY_DELETE") // PENDING_TALLY_DELETE, TALLY_PURGED
  createdAt       DateTime @default(now())
  deletedAt       DateTime @default(now())

  @@index([orgId])
  @@index([orgId, entityType])
  @@index([remoteId])
  @@index([voucherNumber])
}

// ============ EXAMS, ASSESSMENTS & REPORT CARDS ============

model Exam {
  id                 String        @id @default(uuid())
  orgId              String
  departmentId       String?
  title              String        // e.g. "Mid-Term Examination 2026", "Unit Test 1"
  term               String        @default("Term 1") // Term 1, Term 2, Annual, Mid Term
  academicSession    String        @default("2026-2027")
  examType           String        @default("MID_TERM") // MID_TERM, FINAL, UNIT_TEST, SURPRISE_TEST, PRACTICAL
  startDate          DateTime?
  endDate            DateTime?
  status             String        @default("DRAFT") // DRAFT, OPEN_FOR_GRADING, COMPLETED, PUBLISHED
  defaultGradingType String        @default("NUMERICAL") // NUMERICAL, LETTER_GRADE
  defaultMaxMarks    Float         @default(100)
  defaultPassingMarks Float        @default(33)
  targetClassIds     Json          @default("[]") // Array of Team IDs (Class Sections)
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subjects           ExamSubject[]
  scores             ExamScore[]
  reportCards        ReportCard[]

  @@index([orgId])
  @@index([departmentId])
  @@index([status])
}

model ExamSubject {
  id              String      @id @default(uuid())
  examId          String
  subjectName     String      // e.g. "Physics Theory", "Physics Lab", "Mathematics"
  isLabOrPractical Boolean    @default(false)
  gradingType     String      @default("NUMERICAL") // NUMERICAL, LETTER_GRADE
  maxMarks        Float       @default(100)
  passingMarks    Float       @default(33)
  passingGrade    String?     @default("D")
  examDate        DateTime?
  orderIndex      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  exam            Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  scores          ExamScore[]

  @@index([examId])
}

model ExamScore {
  id            String      @id @default(uuid())
  examId        String
  subjectId     String
  studentId     String      // User ID of student
  teamId        String      // Class Section ID
  marksObtained Float?
  grade         String?     // e.g. "A+", "A", "B", "C", "D", "F"
  isAbsent      Boolean     @default(false)
  isPassed      Boolean     @default(true)
  remarks       String?     // Notes / Reason for absence / Teacher observation
  gradedById    String?     // Class Teacher User ID
  gradedAt      DateTime?
  status        String      @default("SUBMITTED") // DRAFT, SUBMITTED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  exam          Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject       ExamSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId, studentId])
  @@index([examId])
  @@index([subjectId])
  @@index([studentId])
  @@index([teamId])
  @@index([isAbsent, isPassed])
}

model ReportCard {
  id                 String    @id @default(uuid())
  orgId              String
  departmentId       String?
  studentId          String
  teamId             String    // Class Section ID
  examId             String?
  academicSession    String    @default("2026-2027")
  term               String    @default("Term 1")
  subjectsJson       Json      // Array of subject breakdown: { subjectName, maxMarks, passingMarks, marksObtained, grade, isAbsent, isPassed, remarks }
  totalMarksObtained Float     @default(0)
  totalMaxMarks      Float     @default(0)
  percentage         Float     @default(0)
  overallGrade       String    @default("N/A")
  resultStatus       String    @default("PASSED") // PASSED, FAILED, WITHHELD, ABSENT
  attendanceStats    Json?     // { totalDays: 90, daysPresent: 85, percentage: 94.4 }
  aiRemarks          String?   // AI-synthesized qualitative feedback
  teacherRemarks     String?   // Teacher's overall remarks
  classTeacherSignUrl String?  // Digital signature PNG/SVG of Class Teacher
  hodSignUrl         String?   // Digital signature PNG/SVG of HOD / Dean
  principalSignUrl   String?   // Digital signature PNG/SVG of Principal
  stampUrl           String?   // Official Institution Stamp / Seal PNG
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  exam               Exam?     @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@unique([orgId, studentId, academicSession, term])
  @@index([orgId])
  @@index([studentId])
  @@index([teamId])
}



