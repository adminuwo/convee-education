# ==========================================
# CONVEE - GitHub Repository .gitignore
# ==========================================

# --- Environment & Credentials (Security) ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env*
*.key
*.pem
.credentials
credentials.json
*token.json*
*key*.json
*serviceaccount*.json
*service-account*.json

# Allow tracked template examples
!.env.example
!**/.env.example

# --- Dependencies & Package Managers ---
node_modules/
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python Virtual Environments
venv/
.venv/
env/
.env/
*.egg-info/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# --- Production & Build Outputs ---
/build
**/build/
dist/
**/dist/
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Prisma Client Generated Artifacts & Query Engines
backend/src/generated/
**/src/generated/
*.node
*.tmp*
query_engine*

# --- Uploads & File Storage ---
uploads/
**/uploads/*
!**/uploads/.gitkeep

# --- Logs, Caches & System Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
.cache/
**/.cache/
.temp/
temp/
.DS_Store
Thumbs.db

# --- Databases ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
.emergent/
.gitconfig

# --- Testing, Reports & Temporary Output ---
/coverage
**/coverage/
test_reports/
test_result.md
scraped_output.json
*.scraped_output.json
agent_artifacts/
.agent_artifacts/
.screenshots/
DUMMY_DATA.txt
mock_students.csv
*.xml
*.png
*.jpg
*.jpeg

# Whitelist UI Assets in frontend
!frontend/public/**
!frontend/src/assets/**

# Scratch & Debug Test Scripts
backend/scripts/test_*.ts
backend/scripts/clean_*.ts
backend/scripts/check_*.ts
backend/scripts/calibrate_*.ts
backend/scripts/verify_*.ts
backend/scripts/security_*.ts
backend/scripts/seed_students_fees.ts
backend/src/scripts/seed-accountant.ts
backend/src/scripts/test-*.ts
backend/src/scripts/test_*.ts
frontend/scripts/
